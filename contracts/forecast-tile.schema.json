{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/forecast-tile.schema.json",
  "title": "PFT1 forecast tile JSON header — see docs/forecast-tile-format.md for the binary layout around it.",
  "type": "object",
  "required": ["spec", "schema_version", "layer", "model", "run_id", "cycle", "generated_at", "tile_id", "lat0", "lon0", "dlat", "dlon", "nlat", "nlon", "time_axes", "member_count", "variables"],
  "properties": {
    "spec": { "const": "PFT1" },
    "schema_version": { "type": "integer" },
    "layer": { "enum": ["weather", "weather-ecmwf", "weather-ecmwf-short", "ensemble", "waves", "currents", "currents-ibi", "weather-arome", "weather-icon-eu", "weather-ukv"] },
    "model": { "type": "string" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9-]+-[0-9]{8}T[0-9]{2}Z$" },
    "cycle": { "type": "string" },
    "generated_at": { "type": "string" },
    "tile_id": { "type": "string", "pattern": "^[NS][0-9]{2}[EW][0-9]{3}$" },
    "lat0": { "type": "number", "minimum": -90, "maximum": 80 },
    "lon0": { "type": "number", "minimum": -180, "maximum": 170 },
    "dlat": { "type": "number", "exclusiveMinimum": 0 },
    "dlon": { "type": "number", "exclusiveMinimum": 0 },
    "nlat": { "type": "integer", "minimum": 1 },
    "nlon": { "type": "integer", "minimum": 1 },
    "time_axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["base", "offsets_h"],
        "properties": {
          "base": { "type": "string" },
          "offsets_h": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 }
        }
      }
    },
    "member_count": { "type": "integer", "minimum": 1 },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "axis", "dtype", "scale", "byte_offset", "byte_length"],
        "properties": {
          "name": { "type": "string" },
          "axis": { "type": "string" },
          "dtype": { "enum": ["i16", "i8"] },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "offset": { "type": "number" },
          "missing": { "type": "integer" },
          "per_member": { "type": "boolean" },
          "statistic": {
            "type": "object",
            "description": "Present when each value is a statistic over the interval ending at its step rather than an instantaneous value (ECMWF gust: the maximum over the last 1, 3 or 6 h). Absent: instantaneous.",
            "required": ["kind", "window_h"],
            "properties": {
              "kind": { "enum": ["max"] },
              "window_h": {
                "type": "array",
                "description": "One entry per step of the variable's axis: the interval length in hours, null where the step carries no value.",
                "items": { "type": ["integer", "null"], "minimum": 1 }
              }
            }
          },
          "byte_offset": { "type": "integer", "minimum": 0, "description": "relative to payload start; 4-byte aligned" },
          "byte_length": { "type": "integer", "minimum": 0, "description": "excludes trailing alignment padding" }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
