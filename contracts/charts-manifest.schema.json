{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepregatta.local/contracts/charts-manifest.schema.json",
  "title": "Chart build manifest (TCP1): one immutable build's world overview and z6 cells, written last; an archive a build reused names the build that wrote it.",
  "type": "object",
  "required": [
    "schema_version",
    "spec",
    "build_id",
    "previous_build_id",
    "purpose",
    "not_for_navigation",
    "chunk_bytes",
    "cell_zoom",
    "world",
    "cells",
    "totals",
    "validation",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec": {
      "const": "TCP1"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z$"
    },
    "previous_build_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{8}T[0-9]{4}Z$"
    },
    "chunk_bytes": {
      "const": 131072,
      "description": "Every chunk digest covers this many bytes (128 KiB since WP10 phase 8, 2026-11-07; 1 MiB before), the last chunk of an object shorter"
    },
    "cell_zoom": {
      "const": 6
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "cells": {
      "type": "object",
      "propertyNames": {
        "pattern": "^6-[0-9]{1,2}-[0-9]{1,2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cell"
      }
    },
    "purpose": {
      "type": "string"
    },
    "not_for_navigation": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "required": [
        "cell_count",
        "objects",
        "bytes",
        "bytes_this_build"
      ],
      "properties": {
        "cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_this_build": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "checks_passed"
      ],
      "properties": {
        "checks_passed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "published_at": {
      "type": "string"
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "required": [
        "key",
        "bytes",
        "sha256",
        "chunks"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^charts/[0-9]{8}T[0-9]{4}Z/[a-z0-9-]+\\.pmtiles$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "protomaps",
        "seamap"
      ],
      "properties": {
        "protomaps": {
          "type": "object",
          "required": [
            "build"
          ],
          "properties": {
            "build": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            }
          }
        },
        "seamap": {
          "type": "object",
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "shom": {
          "type": "object",
          "required": [
            "fetched",
            "content_sha256"
          ]
        },
        "emodnet": {
          "type": "object",
          "required": [
            "product"
          ]
        }
      }
    },
    "world": {
      "allOf": [
        {
          "$ref": "#/$defs/object"
        },
        {
          "type": "object",
          "required": [
            "build_id",
            "inputs_sha256",
            "bounds",
            "minzoom",
            "maxzoom",
            "sources"
          ],
          "properties": {
            "build_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{4}Z$"
            },
            "inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bounds": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "minzoom": {
              "const": 0
            },
            "maxzoom": {
              "const": 5
            },
            "sources": {
              "$ref": "#/$defs/sources"
            }
          }
        }
      ]
    },
    "cell": {
      "allOf": [
        {
          "$ref": "#/$defs/object"
        },
        {
          "type": "object",
          "required": [
            "z",
            "x",
            "y",
            "build_id",
            "inputs_sha256",
            "bounds",
            "minzoom",
            "maxzoom",
            "sources",
            "depth"
          ],
          "properties": {
            "build_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{4}Z$"
            },
            "inputs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bounds": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "minzoom": {
              "const": 6
            },
            "maxzoom": {
              "const": 14
            },
            "sources": {
              "$ref": "#/$defs/sources"
            },
            "z": {
              "const": 6
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "depth": {
              "oneOf": [
                {
                  "$ref": "#/$defs/object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The cell's depth companion; null for a cell with no sea under it (no EMODnet depth)"
            },
            "emodnet": {
              "type": "object",
              "required": [
                "key",
                "bytes",
                "sha256",
                "product_key"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^charts/[0-9]{8}T[0-9]{4}Z/6-[0-9]{1,2}-[0-9]{1,2}\\.emodnet\\.npz$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "product_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "description": "The producer's own: what EMODnet decides for the cell (sea distances and depth tiles), read back by the next build instead of the DTM. Chart readers never read it"
            }
          }
        }
      ]
    }
  }
}
