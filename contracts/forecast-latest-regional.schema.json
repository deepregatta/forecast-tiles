{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/forecast-latest-regional.schema.json",
  "title": "Regional forecast catalogue \u2014 opt-in, separate from root latest.json",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string"
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "weather-arome",
          "weather-icon-eu"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "run_id",
          "cycle",
          "published_at"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+-[0-9]{8}T[0-9]{2}Z$"
          },
          "previous_run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cycle": {
            "type": "string"
          },
          "member_count": {
            "type": "integer",
            "minimum": 1
          },
          "published_at": {
            "type": "string"
          },
          "cadence_hours": {
            "type": "integer",
            "minimum": 1,
            "description": "Hours between the layer's scheduled publications, from the producer's configuration. Optional: consumers fall back to their own schedule when it is absent."
          }
        }
      }
    }
  }
}
