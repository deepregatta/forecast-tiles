{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/forecast-manifest.schema.json",
  "title": "Forecast run manifest — written last to forecast-runs/{run_id}/manifest.json; its presence marks the run complete.",
  "type": "object",
  "required": ["schema_version", "run_id", "layer", "model", "cycle", "member_count", "resolution_deg", "horizon_h", "time_axes", "variables", "tiling", "tiles", "totals", "validation", "published_at"],
  "properties": {
    "schema_version": { "type": "integer" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9-]+-[0-9]{8}T[0-9]{2}Z$" },
    "layer": { "enum": ["weather", "weather-ecmwf", "weather-ecmwf-short", "ensemble", "waves", "currents", "currents-ibi", "weather-arome", "weather-icon-eu"] },
    "model": { "type": "string" },
    "cycle": { "type": "string" },
    "member_count": { "type": "integer", "minimum": 1 },
    "resolution_deg": { "type": "number", "exclusiveMinimum": 0 },
    "horizon_h": { "type": "integer", "minimum": 1 },
    "time_axes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["base", "offsets_h"],
        "properties": {
          "base": { "type": "string" },
          "offsets_h": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "axis", "dtype", "scale"],
        "properties": {
          "name": { "type": "string" },
          "axis": { "type": "string" },
          "dtype": { "enum": ["i16", "i8"] },
          "scale": { "type": "number" },
          "offset": { "type": "number" },
          "per_member": { "type": "boolean" },
          "statistic": {
            "type": "object",
            "description": "Present when each value is a statistic over the interval ending at its step rather than an instantaneous value (ECMWF gust: the maximum over the last 1, 3 or 6 h). Absent: instantaneous.",
            "required": ["kind", "window_h"],
            "properties": {
              "kind": { "enum": ["max"] },
              "window_h": {
                "type": "array",
                "description": "One entry per step of the variable's axis: the interval length in hours, null where the step carries no value.",
                "items": { "type": ["integer", "null"], "minimum": 1 }
              }
            }
          },
          "units": { "type": "string" }
        }
      }
    },
    "tiling": {
      "type": "object",
      "required": ["tile_deg", "path_template"],
      "properties": {
        "tile_deg": { "enum": [5, 10] },
        "path_template": { "type": "string", "description": "e.g. weather/z025/{tile_id}.bin.gz, relative to forecast-runs/{run_id}/" }
      }
    },
    "tiles": {
      "type": "object",
      "propertyNames": { "pattern": "^[NS][0-9]{2}[EW][0-9]{3}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["bytes", "fnv64"],
        "properties": {
          "bytes": { "type": "integer", "minimum": 1 },
          "decoded_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
          "uncompressed_bytes": { "type": "integer", "minimum": 1 },
          "fnv64": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "FNV-1a 64 of the gzipped object as stored" }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["tile_count", "bytes"],
      "properties": {
        "tile_count": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["checks_passed", "validated_at"],
      "properties": {
        "checks_passed": { "type": "array", "items": { "type": "string" } },
        "validated_at": { "type": "string" }
      }
    },
    "coverage": {"type": "object", "required": ["minLat", "maxLat", "minLon", "maxLon"], "properties": {"minLat": {"type": "number"}, "maxLat": {"type": "number"}, "minLon": {"type": "number"}, "maxLon": {"type": "number"}}},
    "served_grid": {"type": "object", "required": ["lat0", "lon0", "dlat", "dlon", "nlat", "nlon"], "properties": {"lat0": {"type": "number"}, "lon0": {"type": "number"}, "dlat": {"type": "number"}, "dlon": {"type": "number"}, "nlat": {"type": "number"}, "nlon": {"type": "number"}}},
    "capabilities": {"type": "array", "items": {"enum": ["wind", "gust"]}},
    "attribution": {"type": "string"},
    "schedule": {"type": "object"},
    "provenance": { "type": "object", "description": "source dataset ids/urls digest; records RTOFS fallback when CMEMS is unavailable" },
    "published_at": { "type": "string" }
  },
  "allOf": [{"if": {"properties": {"layer": {"enum": ["weather-arome", "weather-icon-eu"]}}}, "then": {"required": ["coverage", "served_grid", "capabilities", "attribution"], "properties": {"tiles": {"additionalProperties": {"required": ["decoded_bytes", "uncompressed_bytes"], "properties": {"bytes": {"maximum": 8388608}}}}}}}]
}
